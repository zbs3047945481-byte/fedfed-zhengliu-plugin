{
  "suite_name": "cross_domain_default_a0p1_e1_5090",
  "description": "Cross-domain FedAvg vs FedAvg+fedfed_image under alpha=0.1, E=1, 10 clients, 5 clients per round. Datasets: GTSRB-32, PathMNIST-32, PlantVillage-32.",
  "common_args": {
    "round_num": 300,
