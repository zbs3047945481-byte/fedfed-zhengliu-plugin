<mxCell id="2" value="论文公开代码版 FedFed beta-VAE 生成器 q(x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontSize=18;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="60" as="geometry"/></mxCell>
<mxCell id="3" value="输入 x
3 x 32 x 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="130" height="70" as="geometry"/></mxCell>
<mxCell id="4" value="encoder_former
Conv 4x4, stride=2
3 -&gt; d/2 = 16
32 -&gt; 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="5" value="Encoder
BN + ReLU
Conv 4x4, stride=2
16 -&gt; d = 32
16 -&gt; 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="210" height="110" as="geometry"/></mxCell>
<mxCell id="6" value="ResBlock(d,d) + BN
32 x 8 x 8
增强重构路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="105" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="7" value="ResBlock(d,d)
32 x 8 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="220" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="8" value="Flatten
d*f*f = 32*8*8 = 2048" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="155" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="9" value="fc11
2048 -&gt; z=2048
mu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1220" y="105" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="10" value="fc12
2048 -&gt; z=2048
logvar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1220" y="205" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="11" value="重参数采样
全局 VAE latent
2048 维" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="350" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="12" value="fc21
2048 -&gt; 2048
reshape 为 32 x 8 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="350" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="13" value="Decoder ResBlock
32 x 8 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="330" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="14" value="Decoder ResBlock + BN
32 x 8 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="420" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="15" value="ConvTranspose 4x4, stride=2
32 -&gt; 16
8 -&gt; 16
BN + LeakyReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="350" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="16" value="decoder_last
ConvTranspose 4x4, stride=2
16 -&gt; 3
16 -&gt; 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="350" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="17" value="xi_bn + Sigmoid
输出范围 [0,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="500" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="18" value="q(x)=x_r
performance-robust features
接近原图主体信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="19" value="x_s = x - q(x)
performance-sensitive features
受 rho 范数约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="500" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="20" value="辅助分类器 f
只用于蒸馏阶段
不是主 FedAvg 模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="500" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="21" value="论文代码式目标
5*MSE(q(x),x) + 2*CE(f(x_s),y)
+ 0.005*KL + 0.4*CE(f(x),y) + rho penalty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="630" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="22" value="关键差异：ResBlock + 2048 维全局 latent + 强重构损失，让 q(x) 保留大部分图像内容；小范数残差 x_s 被迫承载类别敏感信息。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="760" height="90" as="geometry"/></mxCell>
