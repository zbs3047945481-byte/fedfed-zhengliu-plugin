<diagram id="old_beta_vae_cn" name="旧版简化 beta-VAE">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="2" value="旧版简化 beta-VAE 生成器 q(x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=18;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1260" height="60" as="geometry"/></mxCell>
<mxCell id="3" value="输入 x
CIFAR-10: 3 x 32 x 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="4" value="Conv 3x3
3 -&gt; 32
BN + ReLU
空间: 32 x 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="170" height="100" as="geometry"/></mxCell>
<mxCell id="5" value="Conv 3x3, stride=2
32 -&gt; 64
BN + ReLU
空间: 16 x 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="6" value="Conv 3x3, stride=2
64 -&gt; latent_channels
旧版默认 64
空间: 8 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="135" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="7" value="1x1 Conv -&gt; mu
8 x 8 特征图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="8" value="1x1 Conv -&gt; logvar
8 x 8 特征图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="9" value="重参数采样
z = mu + eps * std
局部 latent map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="145" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="10" value="ConvTranspose 4x4, stride=2
latent -&gt; 64
BN + ReLU
空间: 16 x 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="11" value="ConvTranspose 4x4, stride=2
64 -&gt; 32
BN + ReLU
空间: 32 x 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="350" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="12" value="Conv 3x3
32 -&gt; 3
Sigmoid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="13" value="输出 q(x)=x_r
重构出的鲁棒部分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="14" value="x_s = x - q(x)
上传共享的敏感残差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="100" y="540" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="15" value="主要差异：结构较浅，没有 ResBlock，也没有 2048 维全局 latent 瓶颈。q(x) 容易变成模糊重构，x_s 容易变成边缘、纹理、噪声残差。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="535" width="520" height="110" as="geometry"/></mxCell>
<mxCell id="16" value="旧目标更接近：CE(f(x_s), y) + rho penalty + 弱 KL。缺少强重构项和 CE(f(x), y) 时，辅助分类器可能只是在适配残差伪特征。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#334155;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="535" width="350" height="110" as="geometry"/></mxCell>
